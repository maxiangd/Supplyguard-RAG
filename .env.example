APP_ENV=development
APP_LOG_LEVEL=INFO

APP_JWT_SECRET_KEY=change-me-in-production
APP_ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_DEMO_PASSWORD=catl123

# PostgreSQL
APP_DATABASE_URL=postgresql+psycopg://supplyguard:123456@127.0.0.1:5432/supplyguard

# 队列：docker compose 起的 Redis（映射到 6380，避开本机已有实例）
APP_REDIS_URL=redis://localhost:6380/0

# 上传
APP_UPLOAD_DIRECTORY=data/uploads
APP_MAX_UPLOAD_SIZE_MB=20

APP_QDRANT_URL=http://localhost:6333
APP_QDRANT_COLLECTION=supplyguard_chunks

APP_EMBEDDING_PROVIDER=ollama
APP_EMBEDDING_MODEL=nomic-embed-text
APP_EMBEDDING_DIMENSION=768

APP_LLM_PROVIDER=ollama
APP_OLLAMA_BASE_URL=http://localhost:11434
APP_OLLAMA_MODEL=deepseek-r1:7b

APP_CHUNK_SIZE=800
APP_CHUNK_OVERLAP=120
APP_TOP_K=4

# SecureRAG：检索前按角色过滤，检索后复核
APP_SECURE_RAG_ENFORCE_ROLES=true
APP_SECURE_RAG_REVIEW_MAX_RETRIES=1
APP_SECURE_RAG_MAX_DROP_RATIO=0.5

# GraphRAG：供应链图谱
APP_NEO4J_URI=bolt://localhost:7687
APP_NEO4J_USER=neo4j
APP_NEO4J_PASSWORD=change-me
APP_NEO4J_DATABASE=neo4j

# Memory
APP_MEMORY_SESSION_TTL_SECONDS=3600
APP_MEMORY_MAX_TURNS=10
APP_MEMORY_LONG_TERM_ENABLED=true

# Benchmark
APP_BENCHMARK_MAX_CASES=200
APP_BENCHMARK_MIN_HIT_RATE=0.8
APP_BENCHMARK_REQUIRE_ZERO_LEAK=true

APP_REQUIRE_APPROVAL=true
APP_OUTPUT_POLICY_ENABLED=true

APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
